# Пример переменных окружения
# Скопируй этот файл в .env и заполни значения

# Режим работы
APP_ENV=development

# Настройки поиска
SEARCH_CITY=Москва
SEARCH_AREA_ID=1
SEARCH_EXPERIENCE=between1And3,between3And6
SEARCH_SALARY=200000
SEARCH_PAGES=3
SEARCH_PER_PAGE=50

# Файлы конфигурации
QUERIES_SPORT=config/queries_sport.txt
QUERIES_CORPORATE=config/queries_corporate.txt
KEYWORDS_SPORT=config/keywords_sport.txt
KEYWORDS_CORPORATE=config/keywords_corporate.txt
STOPWORDS=config/stopwords.txt

# База данных и вывод
DB_PATH=data/vacancies.db
OUTPUT_DIR=output
EXCEL_FILE=output/vacancies.xlsx
REPORT_FILE=output/report.md

# Логирование
LOG_LEVEL=INFO